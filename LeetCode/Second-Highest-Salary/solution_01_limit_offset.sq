-- ===================================================================================
-- PLATFORM         : LeetCode #176 (Second Highest Salary)
-- CORE MECHANICS   : LIMIT 1 OFFSET 1 with Outer Scalar SELECT
-- ===================================================================================
-- TECHNICAL LOGIC:
-- 1. Deduplicates and sorts records via 'DISTINCT' and 'ORDER BY DESC'.
-- 2. Extracts the runner-up salary position using 'LIMIT 1 OFFSET 1'.
-- 3. Encapsulates the logic in an outer scalar SELECT. This handles datasets with 
--    fewer than 2 rows by forcing an empty set to return a single-row NULL value,
--    preventing downstream dashboard ingestion errors (Tableau/Power BI).
-- ===================================================================================

SELECT (
    SELECT DISTINCT salary
    FROM Employee
    ORDER BY salary DESC
    LIMIT 1 OFFSET 1
) AS SecondHighestSalary;
